#!/bin/bash
# /usr/local/bin/terrio-docs-deploy-entry: the forced command of the docs deploy key (~docs-deploy/.ssh/authorized_keys).
# The key can only hand a release to terrio-docs-deploy: the ssh command line must be exactly one commit sha.
set -euo pipefail
cmd=${SSH_ORIGINAL_COMMAND:-}
[[ $cmd =~ ^[0-9a-f]{40}$ ]] || { echo "deploy: expected a 40-hex commit sha" >&2; exit 1; }
exec sudo -n /usr/local/sbin/terrio-docs-deploy "$cmd"
